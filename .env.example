# GovDoc SecureFlow — environment contract (see README)
# Copy to `.env` for local tooling; do not commit `.env`.

# --- Runtime (app / docker-compose) ---
APP_ENV=development
APP_PORT=8000
WEB_PORT=3000

# Frontend: browser calls same-origin `/api/*` (Vite dev proxy / nginx proxy in Docker)
VITE_API_URL=/api/v1

# Backend API base for server-side fetches when needed (compose uses internal DNS)
# API_BASE_URL=http://api:8000

DATABASE_URL=sqlite:///./data/secureflow.db
SECRET_KEY=dev_secret_key_change_in_production
ALLOWED_ORIGINS=http://localhost:3000

# Local file storage (must stay under repo `data/` per project rules)
LOCAL_FILE_STORAGE_ROOT=./data/uploads

# --- Demo / product toggles (baseline uses mocks; live flags reserved) ---
ENABLE_DEMO_MODE=true
ENABLE_CACHED_AI_RESULTS=false
ENABLE_LIVE_OCR=false
ENABLE_LIVE_EMBEDDINGS=false

# Prompt / config paths
PROMPT_CONFIG_PATH=api/prompts
MODELS_CONFIG_PATH=api/config/models.yaml
ROLES_CONFIG_PATH=api/config/roles.yaml
CACHED_AI_STORAGE_ROOT=./data/cached_ai

# --- Alibaba Model Studio (required for `make check-credentials` env validation;
#     live HTTP probe is NOT implemented in Pass 3 — command fails after env check) ---
# NOTE: model ids (qwen-plus, qwen-max, qwen-vl-plus, text-embedding-v4, qwen3-rerank)
# live in `api/config/models.yaml`, NOT in env. See implementation plan §17.2/§17.6.
MODELSTUDIO_API_KEY=
MODELSTUDIO_BASE_URL=
# DashScope endpoint (rerank only — same workspace, different path)
MODELSTUDIO_DASHSCOPE_URL=

# --- Remote deploy contract (`make up-remote`; packaging uses docker save + bundle) ---
REMOTE_HOST=
REMOTE_USER=
REMOTE_APP_DIR=

# Legacy / unused — kept for compatibility with older .env files
GEMINI_API_KEY=
